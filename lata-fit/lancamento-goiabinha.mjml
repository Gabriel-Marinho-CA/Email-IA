  </mj-head>
  <mj-body background-color="#f1f2e4" width="600px">

    <mj-section background-color="#c3dc9a" background-url="https://cdn.shopify.com/s/files/1/0829/8731/9551/files/lf-lg-hero-fundo.jpg" background-size="cover" background-position="center bottom" background-repeat="no-repeat" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px">
      <mj-column>
        <mj-image css-class="lf-logo" src="https://cdn.shopify.com/s/files/1/0829/8731/9551/files/lf-lg-logo.png" alt="Latam Fit" width="123px" height="37px" align="center" href="https://www.latamfit.com.br" padding-top="54px" padding-right="0px" padding-bottom="35px" padding-left="0px"></mj-image>
        <mj-text css-class="lf-h1" align="center" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="42px" font-weight="700" line-height="57px" letter-spacing="-0.5px" color="#648247" padding-top="0px" padding-right="40px" padding-bottom="20px" padding-left="40px">A Goiabinha ganhou chocolate branco!</mj-text>
        <mj-divider css-class="lf-div" border-color="#93b070" border-width="2px" width="330px" align="center" padding-top="0px" padding-right="0px" padding-bottom="24px" padding-left="0px"></mj-divider>
        <mj-text css-class="lf-p" align="center" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="17px" line-height="20px" color="#648247" padding-top="0px" padding-right="24px" padding-bottom="0px" padding-left="24px"><div style="max-width:390px; margin:0 auto;">A goiabinha macia que você já conhece, agora com cobertura sabor chocolate branco. O doce da goiaba com a cremosidade do chocolate, e zero adição de açúcares.</div></mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#f8f5f7" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px">
      <mj-column>
        <mj-image src="https://cdn.shopify.com/s/files/1/0829/8731/9551/files/lf-lg-hero-produto-v2.jpg" alt="Goiabinha com chocolate branco: lançamento Latam Fit" width="600px" href="https://www.latamfit.com.br/collections/goiabinhas/products/combo-goiabada-zero-acucar-barrinha-de-goiabada-e-goiabada-cremosa-em-pote" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px"></mj-image>
      </mj-column>
    </mj-section>

