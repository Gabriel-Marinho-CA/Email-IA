      <mj-section background-color="#f1f2e4" padding-top="0px" padding-right="16px" padding-bottom="0px" padding-left="5px">
        <mj-column>
          <mj-raw><tr><td style="padding:0;" class="fc-html-block"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;"><tr><td class="lf-t-rot" width="25%" valign="top" align="center" style="width:25.09%; padding:0 2px; font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:11px; line-height:14px; color:#00401f; text-align:center;"><img class="lf-t-ic" src="https://cdn.shopify.com/s/files/1/0829/8731/9551/files/lf-lg-icone-1-v2.png" width="48" height="48" alt="" style="display:block; width:48px; height:48px; margin:0 auto 6px; border:0; outline:none;">Goiabada macia,<br>com sabor de<br>fruta de verdade</td><td class="lf-t-rot" width="25%" valign="top" align="center" style="width:25.27%; padding:0 2px; border-left:1px solid #d6e0c5; font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:11px; line-height:14px; color:#00401f; text-align:center;"><img class="lf-t-ic" src="https://cdn.shopify.com/s/files/1/0829/8731/9551/files/lf-lg-icone-2-v2.png" width="48" height="48" alt="" style="display:block; width:48px; height:48px; margin:0 auto 6px; border:0; outline:none;">Cobertura sabor<br>chocolate branco</td><td class="lf-t-rot" width="23%" valign="top" align="center" style="width:22.89%; padding:0 2px; border-left:1px solid #d6e0c5; font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:11px; line-height:14px; color:#00401f; text-align:center;"><img class="lf-t-ic" src="https://cdn.shopify.com/s/files/1/0829/8731/9551/files/lf-lg-icone-3-v2.png" width="48" height="48" alt="" style="display:block; width:48px; height:48px; margin:0 auto 6px; border:0; outline:none;">Zero adição<br>de açúcares</td><td class="lf-t-rot" width="27%" valign="top" align="center" style="width:26.75%; padding:0 2px; border-left:1px solid #d6e0c5; font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:11px; line-height:14px; color:#00401f; text-align:center;"><img class="lf-t-ic" src="http