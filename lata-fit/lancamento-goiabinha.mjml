        .lf-c2 { padding-left:0px !important; padding-right:2px !important; }
        .lf-c3 { padding-left:0px !important; padding-right:12px !important; }
        .lf-btn { padding-top:30px !important; padding-bottom:28px !important; }
        .lf-btn table { width:180px !important; }
