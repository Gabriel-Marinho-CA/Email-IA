        <mj-text css-class="pb-p" align="center" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="17px" line-height="20px" color="#2f2f2f" padding-top="20px" padding-right="24px" padding-bottom="0px" padding-left="24px"><div style="max-width:350px; margin:0 auto;"><strong>Começou</strong> o Pré Black da Latam Fit. Anota o cupom e já deixa a sua lista pronta para aproveitar logo no primeiro dia.</div></mj-text>
        <mj-button css-class="pb-btn1" href="https://www.latamfit.com.br/collections/all" background-color="#5d3795" color="#ffffff" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="18px" font-weight="700" line-height="21px" border-radius="2px" inner-padding="13px 10px" width="274px" align="center" padding-top="32px" padding-right="0px" padding-bottom="9px" padding-left="0px">MONTAR MINHA LISTA</mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#f9faf9" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px">
