        <mj-image src="https://cdn.shopify.com/s/files/1/0829/8731/9551/files/lf-pb-produtos.jpg" alt="Barrinhas Latam Fit com 30% OFF no Pré Black" width="600px" href="https://www.latamfit.com.br/collections/all" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px"></mj-image>
      </mj-column>
    </mj-section>

