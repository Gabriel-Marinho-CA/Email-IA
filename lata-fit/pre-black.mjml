<mjml>
  <mj-head>
    <mj-style>
      @media only screen and (max-width:480px) {
        .pb-p { padding-top:14px !important; }
        .pb-p div { font-size:13.5px !important; line-height:16px !important; }
        .pb-p div div { max-width:278px !important; }
        .pb-btn1 { padding-top:20px !important; padding-bottom:6px !important; }
        .pb-btn1 table { width:200px !important; }
        .pb-btn1 a { width:180px !important; font-size:13.5px !important; line-height:16px !important; padding:11px 10px !important; }
        .pb-cup1 { padding-top:10px !important; }
        .pb-cup1 div { font-size:18px !important; line-height:22px !important; }
        .pb-cup2 { padding-top:2px !important; }
        .pb-cup2 div { font-size:46px !important; line-height:44px !important; letter-spacing:-2px !important; }
        .pb-cup3 { padding-top:6px !important; padding-bottom:12px !important; }
        .pb-cup3 div { font-size:11.5px !important; line-height:14px !important; }
        .pb-h2 { padding-top:24px !important; padding-bottom:14px !important; }
        .pb-h2 div { font-size:22px !important; line-height:28px !important; }
        .pb-t-card { padding:17px 0 18px !important; }
        .pb-t-ic { width:40px !important; height:35px !important; margin-bottom:4px !important; }
        .pb-t-rot { font-size:10.5px !important; line-height:12px !important; }
        .pb-t-row1 { padding-top:33px !important; }
        .pb-t-row2 { padding-top:38px !important; }
        .pb-t-h3 { font-size:26px !important; line-height:33px !important; }
        .pb-t-h3b { font-size:23px !important; line-height:30px !important; padding-top:34px !important; }
        .pb-t-pb { font-size:12.5px !important; line-height:15px !important; max-width:172px !important; padding-top:16px !important; }
        .pb-t-pc { font-size:12.5px !important; line-height:15px !important; max-width:175px !important; padding-top:12px !important; }
        .pb-t-pj { font-size:12.5px !important; line-height:15px !important; max-width:180px !important; padding-top:12px !important; }
        .pb-btn2 { padding-top:34px !important; }
        .pb-btn2 table { width:210px !important; }
        .pb-btn2 a { width:190px !important; font-size:14px !important; line-height:17px !important; padding:12px 10px !important; }
        .pb-ag { padding-top:56px !important; padding-bottom:62px !important; }
        .pb-ag div { font-size:26px !important; line-height:32px !important; }
        .pb-t-flogo { width:56px !important; height:17px !important; }
        .pb-t-ftxt { font-size:11px !important; line-height:14px !important; padding-top:22px !important; padding-bottom:30px !important; }
        .pb-t-fig { width:36px !important; height:36px !important; }
      }
      @media only screen and (max-width:374px) {
        .pb-t-pb { font-size:12px !important; max-width:165px !important; }
        .pb-t-pc { font-size:12px !important; max-width:166px !important; }
        .pb-t-pj { font-size:12px !important; max-width:172px !important; }
      }
      @media only screen and (max-width:359px) {
        .pb-t-rot { font-size:9px !important; line-height:11px !important; }
        .pb-t-h3 { font-size:22px !important; line-height:28px !important; }
        .pb-t-h3b { font-size:20px !important; line-height:26px !important; padding-top:26px !important; }
        .pb-t-pb { font-size:10.5px !important; line-height:13px !important; max-width:144.5px !important; }
        .pb-t-pc { font-size:10.5px !important; line-height:13px !important; max-width:147px !important; }
        .pb-t-pj { font-size:10.5px !important; line-height:13px !important; max-width:150px !important; }
        .pb-cup2 div { font-size:40px !important; line-height:40px !important; }
        .pb-t-ftxt { font-size:10px !important; line-height:13px !important; }
        .pb-t-flogo { width:48px !important; height:15px !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#faf6ec" width="600px">

    <mj-section background-color="#f2f2f2" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px">
