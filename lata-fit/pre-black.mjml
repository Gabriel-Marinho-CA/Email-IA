:none;"><img class="pb-t-ic" src="https://cdn.shopify.com/s/files/1/0829/8731/9551/files/lf-pb-icone-3.png" width="64" height="56" alt="" style="display:block; width:64px; height:56px; margin:0 auto 5px; border:0; outline:none;">Opções<br>veganas</a></td><td class="pb-t-rot" width="101" valign="top" align="center" style="width:21.58%; font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:16px; font-weight:700; line-height:18px; color:#6e2e1e; text-align:center;"><a href="https://www.latamfit.com.br/collections/com-proteina" target="_blank" style="color:#6e2e1e; text-decoration:none;"><img class="pb-t-ic" src="https://cdn.shopify.com/s/files/1/0829/8731/9551/files/lf-pb-icone-4.png" width="64" height="56" alt="" style="display:block; width:64px; height:56px; margin:0 auto 5px; border:0; outline:none;">Opções<br>Proteicas</a></td><td width="21" style="width:4.39%;"></td></tr></table></td></tr></table></td></tr></mj-raw>
