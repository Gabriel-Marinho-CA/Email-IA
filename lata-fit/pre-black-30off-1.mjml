          <mj-button css-class="p30-btn2" href="https://www.latamfit.com.br/collections/all" background-color="#c8365a" color="#ffffff" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="16px" font-weight="700" line-height="22px" letter-spacing="0.8px" border-radius="40px" inner-padding="19px 10px" width="352px" align="center" padding-top="24px" padding-right="0px" padding-bottom="48px" padding-left="0px">COMPRAR COM O CUPOM</mj-button>
        </mj-column>
