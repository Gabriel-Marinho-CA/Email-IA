      <mj-section background-color="#fefdfd" border-radius="0 0 32px 32px" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px">
        <mj-column>
          <mj-image src="https://cdn.shopify.com/s/files/1/0829/8731/9551/files/lf-p30-caixa.jpg" alt="Caixa Surpresa Latam Fit: pague R$ 139 e leve mais de R$ 210 em produtos" width="568px" href="https://www.latamfit.com.br/products/caixa-surpresa" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px"></mj-image>
          <mj-text css-class="p30-of" align="center" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="15px" font-weight="700" line-height="21px" letter-spacing="1px" color="#5a2a1e" padding-top="38px" padding-right="20px" padding-bottom="0px" padding-left="20px">A OFERTA MAIS VANTAJOSA DO PRÉ BLACK</mj-text>
          <mj-text css-class="p30-cx" align="center" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="60px" font-weight="700" line-height="66px" letter-spacing="-0.5px" color="#5a2a1e" padding-top="8px" padding-right="0px" padding-bottom="0px" padding-left="0px">Caixa Surpresa</mj-text>
