  <mj-body background-color="#f8f3e7" width="600px">

    <mj-section background-color="#f8f3e7" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px">
      <mj-column>
        <mj-image css-class="p30-logo" src="https://cdn.shopify.com/s/files/1/0829/8731/9551/files/lf-p30-logo.png" alt="Latam Fit" width="106px" height="32px" align="center" href="https://www.latamfit.com.br" padding-top="20px" padding-right="0px" padding-bottom="0px" padding-left="0px"></mj-image>
        <mj-text css-class="p30-frete" align="center" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="12px" font-weight="700" line-height="16px" letter-spacing="0.6px" color="#5a2a1e" padding-top="8px" padding-right="10px" padding-bottom="20px" padding-left="10px">FRETE GRÁTIS ACIMA DE R$ 99 PARA TODO O BRASIL</mj-text>
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#f7dade" background-url="https://cdn.shopify.com/s/files/1/0829/8731/9551/files/lf-p30-ondas.jpg" background-size="600px auto" background-repeat="repeat" background-position="center top" padding-top="20px" padding-right="16px" padding-bottom="40px" padding-left="16px">
      <mj-section background-color="#f4a8c4" border-radius="32px 32px 0 0" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px">
        <mj-column>
          <mj-text css-class="p30-pre" align="center" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="22px" font-weight="700" line-height="30px" letter-spacing="1.6px" color="#5a2a1e" padding-top="57px" padding-right="10px" padding-bottom="0px" padding-left="10px"><span class="p30-l" style="display:inline-block; width:80px; height:3px; line-height:3px; font-size:1px; background-color:#5a2a1e; vertical-align:middle;">&nbsp;</span><span class="p30-pt" style="display:inline-block; margin:0 18px; vertical-align:middle;">PRÉ BLACK LATAM FIT</span><span class="p30-l" style="display:inline-block; width:80px; height:3px; line-height:3px; font-size:1px; background-color:#5a2a1e; vertical-align:middle;">&nbsp;</span></mj-text>
          <mj-text css-class="p30-big" align="center" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="102px" font-weight="700" line-height="108px" letter-spacing="-2px" color="#ffffff" padding-top="20px" padding-right="0px" padding-bottom="0px" padding-left="0px">30% OFF</mj-text>
          <mj-text css-class="p30-site" align="center" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="46px" font-weight="700" line-height="46px" letter-spacing="-0.5px" color="#5a2a1e" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px">no site todo</mj-text>
          <mj-text css-class="p30-par" align="center" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="18px" font-weight="400" line-height="24px" color="#5a2a1e" padding-top="20px" padding-right="20px" padding-bottom="0px" padding-left="20px"><div style="max-width:455px; margin:0 auto;">Doces zero adição de açúcares, wafers com proteína, caixas e combos. Tudo com desconto até 15/11.</div></mj-text>
          <mj-raw><tr><td style="padding:24px 0 0;" class="fc-html-block p30-c1w"><table role="presentation" align="center" width="371" cellpadding="0" cellspacing="0" border="0" style="width:65.32%; max-width:371px; margin:0 auto; border:2px dashed #f6e77e; border-radius:24px; border-collapse:separate;"><tr><td class="p30-c1" align="center" style="padding:12px 16px; font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; color:#5a2a1e; text-align:center;"><div class="p30-c1a" style="font-size:14px; font-weight:700; line-height:18px; letter-spacing:1px;">USE O CUPOM</div><div class="p30-c1b" style="padding-top:4px; font-size:46px; font-weight:700; line-height:48px; color:#c8365a;">PREBLACK</div><div class="p30-c1c" style="padding-top:4px; font-size:12px; font-weight:700; line-height:16px; letter-spacing:0.5px;">VÁLIDO ATÉ 15/11</div></td></tr></table></td></tr></mj-raw>
          <mj-button css-class="p30-btn1" href="https://www.latamfit.com.br/collections/all" background-color="#f6e77e" color="#5a2a1e" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="16px" font-weight="700" line-height="22px" letter-spacing="0.8px" border-radius="40px" inner-padding="19px 10px" width="320px" align="center" padding-top="24px" padding-right="0px" padding-bottom="5px" padding-left="0px">APROVEITAR 30% OFF</mj-button>
          <mj-image src="https://cdn.shopify.com/s/files/1/0829/8731/9551/files/lf-p30-hero.jpg" alt="Goiabinha, Cocada e Wafer Protein Latam Fit com 30% OFF" width="568px" href="https://www.latamfit.com.br/collections/all" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px"></mj-image>
        </mj-column>
      </mj-section>
      <mj-section background-color="#fefdfd" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px">
        <mj-column>
          <mj-text css-class="p30-h2" align="center" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="32px" font-weight="700" line-height="35px" color="#5a2a1e" padding-top="56px" padding-right="20px" padding-bottom="0px" padding-left="20px">30% OFF em todos os produtos</mj-text>
          <mj-raw><tr><td style="padding:24px 0 0;" class="fc-html-block p30-c2w"><table role="presentation" align="center" width="504" cellpadding="0" cellspacing="0" border="0" style="width:88.73%; max-width:504px; margin:0 auto; background-color:#fffaf0; border:2px dashed #c8365a; border-radius:24px; border-collapse:separate;"><tr><td class="p30-c2" style="padding:24px 32px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;"><tr><td valign="bottom" align="left" style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; color:#5a2a1e; text-align:left;"><div class="p30-c2a" style="font-size:12px; font-weight:700; line-height:16px; letter-spacing:0.7px;">USE O CUPOM</div><div class="p30-c2b" style="padding-top:4px; font-size:42px; font-weight:700; line-height:44px; color:#c8365a;">PREBLACK</div></td><td valign="bottom" align="right" style="text-align:right;"><table role="presentation" align="right" cellpadding="0" cellspacing="0" border="0" style="border-collapse:separate;"><tr><td class="p30-pill" style="padding:15px 32px; background-color:#c8365a; border-radius:28px; font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:20px; font-weight:700; line-height:26px; letter-spacing:1.2px; color:#ffffff; white-space:nowrap;">30% OFF</td></tr></table></td></tr></table></td></tr></table></td></tr></mj-raw>
