<mjml>
  <mj-head>
    <mj-style>
      @media only screen and (max-width:480px) {
        .x-logo { padding-top:26px !important; padding-bottom:16px !important; }
        .x-logo table, .x-logo td { width:96px !important; }
        .x-logo img { width:96px !important; height:29px !important; }
        .x-h1 { padding-left:20px !important; padding-right:20px !important; padding-bottom:10px !important; }
        .x-h1 div { font-size:26px !important; line-height:32px !important; }
        .x-p div { font-size:13.5px !important; line-height:17px !important; }
        .x-p div div { max-width:312px !important; }
        .x-h2 { padding-top:14px !important; padding-bottom:16px !important; }
        .x-h2 div { font-size:22px !important; line-height:27px !important; }
        .x-ic { width:36px !important; height:36px !important; margin-bottom:4px !important; }
        .x-rot { font-size:10px !important; line-height:12px !important; }
        .x-sp div { height:20px !important; line-height:20px !important; }
        .x-btn { padding-top:28px !important; padding-bottom:28px !important; }
        .x-btn table { width:180px !important; }
        .x-btn a { width:160px !important; font-size:15px !important; line-height:18px !important; padding:13px 10px !important; }
        .x-flogo { width:62px !important; height:19px !important; }
        .x-ftxt { font-size:11px !important; line-height:14px !important; padding-top:14px !important; padding-bottom:14px !important; }
        .x-fig { width:38px !important; height:38px !important; }
      }
      @media only screen and (max-width:359px) {
        .x-rot { font-size:9px !important; line-height:11px !important; }
        .x-ftxt { font-size:10px !important; line-height:13px !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f1f2e4" width="600px">

    <mj-section background-color="#c3dc9a" background-url="https://cdn.shopify.com/s/files/1/0000/0000/0000/files/marca-tpl-hero-fundo.jpg" background-size="cover" background-position="center bottom" background-repeat="no-repeat" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px">
      <mj-column>
        <mj-image css-class="x-logo" src="https://cdn.shopify.com/s/files/1/0000/0000/0000/files/marca-tpl-logo.png" alt="Marca" width="123px" height="37px" align="center" href="https://loja.com.br" padding-top="54px" padding-right="0px" padding-bottom="35px" padding-left="0px"></mj-image>
        <mj-text css-class="x-h1" align="center" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="42px" font-weight="700" line-height="57px" color="#648247" padding-top="0px" padding-right="40px" padding-bottom="20px" padding-left="40px">Título em cima da imagem</mj-text>
        <mj-text css-class="x-p" align="center" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="17px" line-height="20px" color="#648247" padding-top="0px" padding-right="24px" padding-bottom="0px" padding-left="24px"><div style="max-width:390px; margin:0 auto;">Parágrafo que quebra como no layout no desktop e, com outro max-width, no celular.</div></mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px">
      <mj-column>
        <mj-image src="https://cdn.shopify.com/s/files/1/0000/0000/0000/files/marca-tpl-hero-produto.jpg" alt="Descrição da imagem" width="600px" href="https://loja.com.br/collections/all" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px"></mj-image>
      </mj-column>
    </mj-section>

    <mj-section css-class="fc-if--primeiro_nome" background-color="#ffffff" padding-top="0px" padding-right="40px" padding-bottom="0px" padding-left="40px">
      <mj-column>
        <mj-text css-class="x-h2" align="center" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="20px" font-weight="700" line-height="26px" color="#648247" padding-top="32px" padding-right="0px" padding-bottom="0px" padding-left="0px">Oi, {{primeiro_nome}}!</mj-text>
      </mj-column>
    </mj-section>

    <mj-section css-class="fc-ifnot--primeiro_nome" background-color="#ffffff" padding-top="0px" padding-right="40px" padding-bottom="0px" padding-left="40px">
      <mj-column>
        <mj-text css-class="x-h2" align="center" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="20px" font-weight="700" line-height="26px" color="#648247" padding-top="32px" padding-right="0px" padding-bottom="0px" padding-left="0px">Oi!</mj-text>
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#ffffff" padding-top="24px" padding-right="16px" padding-bottom="0px" padding-left="16px">
      <mj-section background-color="#f1f2e4" border-radius="14px 14px 0 0" padding-top="0px" padding-right="16px" padding-bottom="0px" padding-left="16px">
        <mj-column>
          <mj-text css-class="x-h2" align="center" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="28px" font-weight="700" line-height="34px" color="#648247" padding-top="24px" padding-right="0px" padding-bottom="20px" padding-left="0px">Card arredondado</mj-text>
        </mj-column>
      </mj-section>
      <mj-section background-color="#f1f2e4" padding-top="0px" padding-right="8px" padding-bottom="0px" padding-left="8px">
        <mj-column>
          <mj-raw><tr><td style="padding:0;" class="fc-html-block"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;"><tr><td class="x-rot" width="33%" valign="top" align="center" style="width:33.33%; padding:0 4px; font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:12px; line-height:15px; color:#00401f; text-align:center;"><img class="x-ic" src="https://cdn.shopify.com/s/files/1/0000/0000/0000/files/marca-tpl-icone-1.png" width="48" height="48" alt="" style="display:block; width:48px; height:48px; margin:0 auto 6px; border:0;">Benefício<br>um</td><td class="x-rot" width="33%" valign="top" align="center" style="width:33.34%; padding:0 4px; border-left:1px solid #d6e0c5; font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:12px; line-height:15px; color:#00401f; text-align:center;"><img class="x-ic" src="https://cdn.shopify.com/s/files/1/0000/0000/0000/files/marca-tpl-icone-2.png" width="48" height="48" alt="" style="display:block; width:48px; height:48px; margin:0 auto 6px; border:0;">Benefício<br>dois</td><td class="x-rot" width="33%" valign="top" align="center" style="width:33.33%; padding:0 4px; border-left:1px solid #d6e0c5; font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:12px; line-height:15px; color:#00401f; text-align:center;"><img class="x-ic" src="https://cdn.shopify.com/s/files/1/0000/0000/0000/files/marca-tpl-icone-3.png" width="48" height="48" alt="" style="display:block; width:48px; height:48px; margin:0 auto 6px; border:0;">Benefício<br>três</td></tr></table></td></tr></mj-raw>
        </mj-column>
      </mj-section>
      <mj-section background-color="#f1f2e4" border-radius="0 0 14px 14px" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px">
        <mj-column>
          <mj-spacer css-class="x-sp" height="28px"></mj-spacer>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section background-color="#ffffff" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px">
      <mj-column>
        <mj-button css-class="x-btn" href="https://loja.com.br/collections/all" background-color="#648247" color="#ffffff" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="20px" font-weight="400" line-height="24px" border-radius="6px" inner-padding="18px 10px" width="233px" align="center" padding-top="32px" padding-right="0px" padding-bottom="40px" padding-left="0px">COMPRAR AGORA!</mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#648247" border-radius="0 0 12px 12px" padding-top="0px" padding-right="31px" padding-bottom="0px" padding-left="31px">
      <mj-column>
        <mj-raw><tr><td style="padding:0;" class="fc-html-block"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;"><tr><td width="104" valign="middle" align="center" style="width:19.33%;"><a href="https://loja.com.br" target="_blank"><img class="x-flogo" src="https://cdn.shopify.com/s/files/1/0000/0000/0000/files/marca-tpl-logo-branco.png" width="100" height="30" alt="Marca" style="display:block; width:100%; max-width:100px; height:auto; margin:0 auto; border:0;"></a></td><td class="x-ftxt" width="325" valign="middle" align="center" style="width:60.41%; padding:30px 0 32px; font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:16px; line-height:20px; color:#ffffff; text-align:center;">Marca · Cidade, UF<br>WhatsApp (00) 00000-0000</td><td width="109" valign="middle" align="center" style="width:20.26%;"><a href="https://www.instagram.com/marca/" target="_blank"><img class="x-fig" src="https://cdn.shopify.com/s/files/1/0000/0000/0000/files/marca-tpl-instagram.png" width="60" height="60" alt="Instagram" style="display:block; width:100%; max-width:60px; height:auto; margin:0 auto; border:0;"></a></td></tr></table></td></tr></mj-raw>
      </mj-column>
    </mj-section>

    <mj-section padding-top="20px" padding-right="32px" padding-bottom="28px" padding-left="32px">
      <mj-column>
        <mj-text align="center" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="11px" line-height="17px" color="#7d8a6f" padding-top="0px" padding-right="0px" padding-bottom="8px" padding-left="0px">Razão Social Ltda · CNPJ 00.000.000/0001-00<br>Rua Exemplo, 100 · Cidade/UF · 00000-000</mj-text>
        <mj-text align="center" font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="11px" line-height="17px" color="#7d8a6f" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px">Você recebeu este e-mail porque se cadastrou ou comprou na Marca.<br><a href="{{link_optout}}" style="color:#648247; text-decoration:underline;">Não quero mais receber</a></mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
