        <mj-text align="center" font-family="'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="12px" font-weight="700" line-height="16px" letter-spacing="2.5px" color="#a64208" padding-top="0px" padding-right="0px" padding-bottom="8px" padding-left="0px">SEU CUPOM DE 15% OFF</mj-text>
        <mj-text align="center" font-family="'HWT Artz', 'Helvetica Neue Condensed', 'HelveticaNeue-CondensedBold', 'Roboto Condensed', 'Arial Narrow', 'Helvetica Neue', Arial, sans-serif" font-size="42px" font-weight="700" line-height="48px" letter-spacing="2px" color="#d4471a" padding-top="0px" padding-right="0px" padding-bottom="8px" padding-left="0px"><span style="white-space:nowrap;">VOLTA15</span></mj-text>
        <mj-text align="center" font-family="'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="14px" line-height="20px" color="#571713" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px">Em todos os produtos · 1 uso por cliente</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding-top="24px" padding-right="48px" padding-bottom="40px" padding-left="48px">
