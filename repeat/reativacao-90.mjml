        <mj-text align="center" font-family="'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="24px" font-weight="700" line-height="30px" color="#d4471a" padding-top="0px" padding-right="0px" padding-bottom="12px" padding-left="0px">Oi, {{primeiro_nome}}!</mj-text>
      </mj-column>
    </mj-section>

    <mj-section css-class="fc-ifnot--primeiro_nome" background-color="#ffffff" padding-top="16px" padding-right="48px" padding-bottom="0px" padding-left="48px">
      <mj-column>
        <mj-text align="center" font-family="'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="24px" font-weight="700" line-height="30px" color="#d4471a" padding-top="0px" padding-right="0px" padding-bottom="12px" padding-left="0px">Oi!</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding-top="0px" padding-right="48px" padding-bottom="26px" padding-left="48px">
