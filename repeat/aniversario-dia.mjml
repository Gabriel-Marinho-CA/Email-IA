    <mj-section background-color="#f2e2dc" padding-top="0px" padding-right="48px" padding-bottom="0px" padding-left="48px">
      <mj-column background-color="#ffffff" border="2px dashed #d4471a" border-radius="18px" padding-top="22px" padding-right="12px" padding-bottom="22px" padding-left="12px">
        <mj-text align="center" font-family="'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="12px" font-weight="700" line-height="16px" letter-spacing="2.5px" color="#a64208" padding-top="0px" padding-right="0px" padding-bottom="8px" padding-left="0px">PRESENTE DO DIA · SÓ HOJE</mj-text>
        <mj-text align="center" font-family="'HWT Artz', 'Helvetica Neue Condensed', 'HelveticaNeue-CondensedBold', 'Roboto Condensed', 'Arial Narrow', 'Helvetica Neue', Arial, sans-serif" font-size="42px" font-weight="700" line-height="48px" letter-spacing="2px" color="#d4471a" padding-top="0px" padding-right="0px" padding-bottom="8px" padding-left="0px"><span style="white-space:nowrap;">NIVER15</span></mj-text>
        <mj-text align="center" font-family="'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="14px" line-height="20px" color="#571713" padding-top="0px" padding-right="0px" padding-bottom="0px" padding-left="0px"><span style="white-space:nowrap;">15% OFF no pedido inteiro</span> · <span style="white-space:nowrap;">válido só hoje</span></mj-text>
      </mj-column>
