        <mj-text align="center" font-family="'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="13px" line-height="18px" color="#8a4b3f" padding-top="0px" padding-right="10px" padding-bottom="12px" padding-left="10px">com quinoa crocante</mj-text>
