        <mj-text align="center" font-family="'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="13px" line-height="18px" color="#8a4b3f" padding-top="0px" padding-right="10px" padding-bottom="12px" padding-left="10px">Proteína e fibra</mj-text>
        <mj-button href="https://repeatonline.com.br/products/snack-de-ervilha-wasabi-repeat-50g" background-color="#d4471a" color="#ffffff" font-family="'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="13px" font-weight="700" letter-spacing="1px" border-radius="40px" inner-padding="10px 24px" padding-top="0px" padding-right="0px" padding-bottom="18px" padding-left="0px">COMPRAR</mj-button>
