        <mj-text align="center" font-family="'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="15px" font-weight="700" line-height="20px" color="#571713" padding-top="0px" padding-right="10px" padding-bottom="2px" padding-left="10px">Bombom de Brownie</mj-text>
        <mj-text align="center" font-family="'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="13px" line-height="18px" color="#8a4b3f" padding-top="0px" padding-right="10px" padding-bottom="12px" padding-left="10px">Zero açúcar</mj-text>
        <mj-button href="https://repeatonline.com.br/products/bombom-de-brownie-meio-amargo-repeat-zero-60g" background-color="#d4471a" color="#ffffff" font-family="'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif" font-size="13px" font-weight="700" letter-spacing="1px" border-radius="40px" inner-padding="10px 24px" padding-top="0px" padding-right="0px" padding-bottom="18px" padding-left="0px">COMPRAR</mj-button>
